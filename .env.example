# Copy this file to .env and fill in real values.
# docker compose loads .env automatically from this directory.

# Resend API key used to send the contact form email (app/kontakt/actions.ts).
RESEND_API_KEY=

# Mailbox that receives contact form submissions.
CONTACT_TO_EMAIL=

# Optional: host port for the production `web` service (default 8018).
# PORT=8018

# Optional: host port for the `dev` profile service (default 8018).
# DEV_PORT=8018
